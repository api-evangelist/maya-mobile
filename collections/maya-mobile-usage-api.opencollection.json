{
  "opencollection": "1.0.0",
  "info": {
    "name": "Maya Mobile Connect+ Connectivity eSIMs Usage API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get eSIM data usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.maya.net/connectivity/v1/esims/:esimId/usage",
            "params": [
              {
                "name": "esimId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns real-time data-usage and installation status for an eSIM."
        }
      ]
    }
  ],
  "bundled": true
}